PORT=5000
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=eventflow

# Base URL of the frontend — used to build the /rsvp/:token link emailed to guests
CLIENT_URL=http://localhost:3000

# Outgoing email for guest RSVP invites (Nodemailer). Leave unset in dev and
# invites still "send" via a throwaway Ethereal test inbox — check the
# server console for a preview URL. Set these to send real email, e.g. via
# Gmail SMTP (smtp.gmail.com, port 587, an App Password as SMTP_PASS) or any
# other SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EventFlow <no-reply@eventflow.local>"

# SSLCommerz sandbox credentials (register free at
# https://developer.sslcommerz.com/registration/) — used for the 10% venue
# booking deposit and the full vendor hire payment. SERVER_URL must be
# reachable by the customer's browser for the success/fail/cancel redirects
# to work (localhost is fine for dev); SSLCommerz's own servers can't reach
# localhost for the ipn_url backstop.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
SERVER_URL=http://localhost:5000